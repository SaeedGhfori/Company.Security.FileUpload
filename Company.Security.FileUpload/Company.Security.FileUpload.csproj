<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);XML0042</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Version>1.0.0</Version>
    <PackageId>Company.Security.FileUpload</PackageId>
    <Title>Company.Security.FileUpload</Title>
    <Description>A secure file upload validation library for .NET. Validates file types by content (magic bytes + container structure), enforces policies, and supports optional malware scanning. Zero external NuGet dependencies in the core library.</Description>
    <Authors>Company Security Team</Authors>
    <Company>Company</Company>
    <Copyright>2026 Company</Copyright>
    <LicenseExpression>MIT</LicenseExpression>
    <RepositoryUrl>https://github.com/company/Company.Security.FileUpload</RepositoryUrl>
    <PackageTags>security;file-upload;validation;malware-scan;OWASP</PackageTags>
    <PackOnBuild>false</PackOnBuild>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
