# EditorConfig for Company.Security.FileUpload
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
# Nullable - keep as warnings (real issues)
dotnet_diagnostic.CS8618.severity = warning
dotnet_diagnostic.CS8625.severity = warning
dotnet_diagnostic.CS8602.severity = warning
dotnet_diagnostic.CS8604.severity = warning
dotnet_diagnostic.CS8603.severity = warning
dotnet_diagnostic.CS8601.severity = warning
dotnet_diagnostic.CS8600.severity = warning
dotnet_diagnostic.CS8622.severity = warning
dotnet_diagnostic.CS8629.severity = warning
dotnet_diagnostic.CS8981.severity = silent
dotnet_diagnostic.CS9130.severity = silent
dotnet_diagnostic.CS0219.severity = silent
dotnet_diagnostic.CS1591.severity = silent
# Style rules - match existing code, don't flood Error List for now
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_diagnostic.IDE0160.severity = silent
dotnet_diagnostic.IDE0161.severity = silent
dotnet_diagnostic.IDE0130.severity = silent
dotnet_diagnostic.IDE0005.severity = silent
dotnet_diagnostic.IDE0008.severity = silent
dotnet_diagnostic.IDE0019.severity = suggestion
dotnet_diagnostic.IDE0011.severity = silent
dotnet_diagnostic.IDE0021.severity = silent
dotnet_diagnostic.IDE0022.severity = silent
dotnet_diagnostic.IDE0040.severity = suggestion
dotnet_diagnostic.IDE0048.severity = silent
dotnet_diagnostic.IDE0055.severity = silent
dotnet_diagnostic.IDE0058.severity = silent
dotnet_diagnostic.IDE0060.severity = silent
dotnet_diagnostic.IDE0220.severity = suggestion
dotnet_diagnostic.IDE0250.severity = suggestion
dotnet_diagnostic.IDE0270.severity = suggestion
dotnet_diagnostic.IDE0043.severity = suggestion
dotnet_diagnostic.IDE0290.severity = silent
dotnet_diagnostic.IDE0300.severity = silent
dotnet_diagnostic.IDE0301.severity = silent
dotnet_diagnostic.IDE0305.severity = silent
dotnet_diagnostic.CA1050.severity = silent
dotnet_diagnostic.CA1039.severity = silent
dotnet_diagnostic.CA1062.severity = suggestion
dotnet_diagnostic.CA2007.severity = silent
dotnet_diagnostic.CA2016.severity = suggestion
dotnet_diagnostic.CA2101.severity = suggestion
dotnet_diagnostic.CA2254.severity = suggestion
dotnet_diagnostic.CA1822.severity = suggestion
dotnet_diagnostic.CA1816.severity = suggestion
dotnet_diagnostic.CA1303.severity = silent
dotnet_diagnostic.CA1307.severity = silent
dotnet_diagnostic.CA2211.severity = silent
dotnet_diagnostic.CA2000.severity = silent
dotnet_diagnostic.CA2201.severity = suggestion
dotnet_diagnostic.CA2208.severity = silent
dotnet_diagnostic.CA2012.severity = silent
dotnet_diagnostic.CA2015.severity = silent
dotnet_diagnostic.CA1031.severity = silent
dotnet_diagnostic.CA1502.severity = silent
dotnet_diagnostic.CA1508.severity = silent
dotnet_diagnostic.CA1509.severity = silent
dotnet_diagnostic.CA1717.severity = silent
dotnet_diagnostic.CA1716.severity = silent
dotnet_diagnostic.RS1024.severity = silent
dotnet_diagnostic.CA2250.severity = silent
dotnet_diagnostic.xUnit1031.severity = silent
dotnet_diagnostic.xUnit2004.severity = silent

[*.{cs,csx}]
dotnet_analyzer_diagnostic.category-Performance.severity = suggestion
dotnet_analyzer_diagnostic.category-Usage.severity = suggestion
dotnet_analyzer_diagnostic.category-Reliability.severity = suggestion
dotnet_analyzer_diagnostic.category-Security.severity = warning
dotnet_analyzer_diagnostic.category-Style.severity = silent

[*.csproj]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_size = 2
